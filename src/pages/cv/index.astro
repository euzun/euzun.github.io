<BaseLayout title="CV · Erkam Uzun" description="Curriculum vitae — education, experience, projects, service, teaching, and awards.">
  <div class="cv-head">
    <h1>Curriculum Vitae</h1>
  </div>
  <p class="lead">
    Publications and patents have dedicated pages:
    <a href="/research">Publications</a> · <a href="/patents">Patents</a>.
  </p>

  <h2>Earned Degrees</h2>
  <ul class="entry-list">
    {degrees.map((d) => (
      <li class="entry">
        <div class="entry-row">
          <span><strong>{d.title}</strong>, {d.org}</span>
          <span class="years">{d.years}</span>
        </div>
        {d.detail && <p class="entry-detail">{d.detail}</p>}
      </li>
    ))}
  </ul>

  <h2>Employment History</h2>
  <div class="indent">
    <h3 class="sub">Academic and Research Appointments</h3>
    <ul class="entry-list indent">
      {academicAppointments.map((e) => (
        <li class="entry">
          <div class="entry-row">
            <span><strong>{e.role}.</strong> {e.org}</span>
            <span class="years">{e.years}</span>
          </div>
        </li>
      ))}
    </ul>
    <h3 class="sub">Industry Experience</h3>
    <ul class="entry-list indent">
      {industryExperience.map((e) => (
        <li class="entry">
          <div class="entry-row">
            <span><strong>{e.role}.</strong> {e.org}</span>
            <span class="years">{e.years}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <h2>Technical Skills</h2>
  <div class="indent skills">
    {skills.map((s) => (
      <p class="skill-line"><span class="skill-cat">{s.category}:</span> {s.items.join(', ')}</p>
    ))}
  </div>

  <h2>Research &amp; Projects</h2>
  <p class="hint">Click an employer to expand its projects.</p>
  {projectGroups.map((group) => (
    <details class="org">
      <summary>
        <span class="org-name">{group.org}</span>
        <span class="chevron" aria-hidden="true">▸</span>
      </summary>
      <div class="org-body">
        {group.projects.map((p) => (
          <div class="proj">
            <p class="proj-name">{p.name}</p>
            <ul class="proj-bullets">
              {p.bullets.map((b) => <li>{b}</li>)}
            </ul>
            {p.link && <p class="proj-link"><a href={p.link}>View project page →</a></p>}
          </div>
        ))}
      </div>
    </details>
  ))}

  <h2>Service</h2>
  <div class="indent">
    {service.map((s) => (
      <div class="svc">
        <h3 class="sub">{s.label}</h3>
        <ul class="entry-list indent">
          {s.items.map((i) => (
            <li class="entry"><div class="entry-row"><span>{i.name}</span><span class="years">{i.years}</span></div></li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <h2>Teaching</h2>
  <div class="indent">
    {teaching.map((s) => (
      <div class="svc">
        <h3 class="sub">{s.label}</h3>
        <ul class="entry-list indent">
          {s.items.map((i) => (
            <li class="entry"><div class="entry-row"><span>{i.name}</span><span class="years">{i.years}</span></div></li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <h2>Honors &amp; Awards</h2>
  <ul class="entry-list">
    {awards.map((a) => (
      <li class="entry"><div class="entry-row"><span>{a.name}</span><span class="years">{a.years}</span></div></li>
    ))}
  </ul>

  <h2>Media Coverage</h2>
  <ul class="entry-list">
    {media.map((m) => (
      <li class="entry">
        <span>
          <strong><a href={m.url} target="_blank" rel="noopener noreferrer">{m.outlet}</a>:</strong> {m.text}
        </span>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .cv-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .cv-head h1 {
    margin-bottom: 0;
  }
  .lead {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    margin: 0.75rem 0 0.5rem;
  }
  /* Section headers — strong accent (teal-blue) */
  h2 {
    color: var(--color-accent);
    border-bottom: 2px solid var(--color-accent-muted);
  }
  /* Sub-section labels — lighter tone of the same blue, uppercase */
  .sub {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--color-accent);
    opacity: 0.78;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 1rem 0 0.4rem;
  }
  .hint, .entry-detail, .proj-link {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
  .skills {
    margin-top: 0.4rem;
  }
  .skill-line {
    font-size: var(--font-size-sm);
    line-height: 1.6;
    margin-bottom: 0.4rem;
    color: var(--color-text);
  }
  .skill-cat {
    font-weight: 700;
    color: var(--color-accent);
  }
  .hint {
    margin-bottom: 0.5rem;
  }
  .entry-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .entry {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .entry:last-child {
    border-bottom: none;
  }
  .entry-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
  }
  .years {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .entry-detail {
    margin-top: 0.2rem;
  }

  /* Indentation for nested sub-sections — subtle blue rule */
  .indent {
    padding-left: 1.1rem;
    border-left: 2px solid var(--color-accent-muted);
    margin-left: 0.1rem;
  }
  .indent .sub:first-child {
    margin-top: 0.6rem;
  }
  /* nested list under a sub-label: softer, no double-strong border */
  .entry-list.indent {
    border-left-color: var(--color-border);
  }

  /* Employer-level accordion */
  .org {
    border-bottom: 1px solid var(--color-border-2);
  }
  .org > summary {
    list-style: none;
    cursor: pointer;
    padding: 0.7rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--font-size-lg);
  }
  .org > summary::-webkit-details-marker {
    display: none;
