---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Explicit display order
const order = [
  'flpsi-fuzzy-psi',
  'privacy-biometric-auth',
  'rtcaptcha',
  'jpgscraper',
  'sensor-fingerprinting',
  'audio-forensics',
  'optimization-wsn',
];

const all = (await getCollection('projects')).filter((p) => !p.data.industry);
const projects = order
  .map((slug) => all.find((p) => p.slug === slug))
  .filter(Boolean);
---

<BaseLayout title="Projects · Erkam Uzun" description="Research projects in cryptography, privacy, biometrics, and digital forensics.">
  <h1>Projects</h1>
  <p class="lead">
    Research projects in applied cryptography, privacy-preserving systems,
    biometrics, and digital forensics. Click any project for details,
    publications, and resources.
  </p>

  <div class="proj-rows">
    {projects.map((project) => (
      <a class="row" href={`/projects/${project!.slug}`}>
        {(project!.data.icon || project!.data.hero) && (
          <div class="row-icon">
            <img src={project!.data.icon ?? project!.data.hero} alt="" loading="lazy" />
          </div>
        )}
        <div class="row-body">
          <h3>{project!.data.name}</h3>
          <p class="row-meta">
            {project!.data.org} · {project!.data.yearStart}{project!.data.yearEnd ? `–${project!.data.yearEnd}` : ''}
          </p>
          <p class="row-desc">{project!.data.shortDescription}</p>
        </div>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .lead {
    color: var(--color-text-muted);
    margin-bottom: 1.75rem;
  }

  .proj-rows {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .row {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .row:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-card);
  }

  .row-icon {
    flex: 0 0 96px;
    border-right: 1px solid var(--color-border);
  }

  .row-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .row-body {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0.8rem 1.1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .row h3 {
    color: var(--color-text);
    font-size: var(--font-size-lg);
    line-height: 1.25;
    margin-bottom: 0.15rem;
  }

  .row-meta {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-bottom: 0.35rem;
  }

  .row-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 560px) {
    .row-icon {
      flex-basis: 76px;
    }
    .row-desc {
      -webkit-line-clamp: 3;
    }
  }
</style>
