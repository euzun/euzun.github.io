---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';

const allPosts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title="Blog · Erkam Uzun" description="Articles on cryptography, engineering, and AI systems.">
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <h1>Blog</h1>
    <p class="text-lg text-text-muted mb-12">Technical writing on cryptography, privacy systems, and applied engineering.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {allPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </article>
</BaseLayout>
