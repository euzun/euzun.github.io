---
import type { CollectionEntry } from 'astro:content';
import { formatDate, calculateReadTime } from '../../lib/utils';
import CategoryPill from '../ui/CategoryPill.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const { title, description, pubDate, category } = post.data;
const readTime = post.data.readTime || calculateReadTime(post.body || '');
---

<article
  class={`border border-border rounded-lg p-6 hover:shadow-hover transition-all ${!compact ? 'hover:-translate-y-1' : ''}`}
>
  <div class="flex items-start justify-between gap-4 mb-3">
    <CategoryPill category={category} />
    <time class="text-xs text-text-muted whitespace-nowrap">
      {formatDate(pubDate)}
    </time>
  </div>

  <h3 class="text-lg font-display font-semibold mb-2">
    <a href={`/blog/${post.slug}`} class="no-underline hover:text-accent transition-colors">
      {title}
    </a>
  </h3>

  <p class="text-sm text-text-muted mb-4">
    {description}
  </p>

  <div class="text-xs text-text-subtle">
    {readTime} min read
  </div>
</article>

<style>
  a {
    border-bottom: none;
  }
</style>
