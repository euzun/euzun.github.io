---
import { SOCIAL_LINKS } from '../../lib/constants';

const links = [
  {
    label: 'Google Scholar',
    href: SOCIAL_LINKS.scholar,
    icon: 'M12 14l9-5-9-5-9 5 9 5zm0 0v7m0-7l-6.5-3.6M12 14l6.5-3.6',
  },
  {
    label: 'GitHub',
    href: SOCIAL_LINKS.github,
    icon: 'M12 2a10 10 0 00-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.56 9.56 0 015 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0012 2z',
  },
  {
    label: 'LinkedIn',
    href: SOCIAL_LINKS.linkedin,
    icon: 'M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.4c0-1.3-.02-2.97-1.8-2.97-1.8 0-2.08 1.4-2.08 2.87V21h-4z',
  },
];
---

<aside class="author-sidebar">
  <img src="/images/avatar.png" alt="Erkam Uzun" class="author-avatar" />
  <h2 class="author-name">Erkam Uzun</h2>
  <p class="author-title">Software Engineer</p>
  <p class="author-bio">
    Applied cryptography, privacy-preserving systems, and large-scale identity
    infrastructure. PhD, Georgia Tech (advisor: Wenke Lee).
  </p>

  <ul class="author-links">
    {links.map((l) => (
      <li>
        <a href={l.href} target="_blank" rel="noopener noreferrer">
          <svg class="author-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d={l.icon} />
          </svg>
          <span>{l.label}</span>
        </a>
      </li>
    ))}
  </ul>

  <p class="author-email">Email: [name][lastname]@gmail.com</p>
</aside>

<style>
  .author-sidebar {
    text-align: left;
  }

  .author-avatar {
    width: 9rem;
    height: 9rem;
    border-radius: var(--radius-full);
    object-fit: cover;
    margin: 0 0 1.25rem;
    border: 4px solid var(--color-surface-2);
  }

  .author-name {
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }

  .author-title {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .author-bio {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .author-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: inline-flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: left;
  }

  .author-links a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    border-bottom: none;
    transition: color var(--transition-fast);
  }

  .author-links a:hover {
    color: var(--color-accent);
  }

  .author-icon {
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
  }

  .author-email {
    margin-top: 1rem;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
</style>
